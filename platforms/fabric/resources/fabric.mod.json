{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.fishgames.vectrum.platform.fabric.VectrumFabric"
    ],
    "client": [
      "io.github.fishgames.vectrum.platform.fabric.VectrumFabricClient"
    ],
    "jade": [
      "io.github.fishgames.vectrum.compat.jade.VectrumJadePlugin"
    ],
    "jei_mod_plugin": [
      "io.github.fishgames.vectrum.compat.jei.VectrumJeiPlugin"
    ],
    "emi": [
      "io.github.fishgames.vectrum.compat.emi.VectrumEmiPlugin"
    ],
    "fabric-datagen": [
      "io.github.fishgames.vectrum.platform.fabric.VectrumFabricDataGenerator"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
